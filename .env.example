# =============================================================================
# FPOWS — Environment Configuration
# =============================================================================
# Copy this file to ".env" and fill in the real values:
#     cp .env.example .env        (bash)
#     Copy-Item .env.example .env (PowerShell)
#
# ".env" is git-ignored and is read automatically at runtime (when NODE_ENV
# is not "production") and by deploy.ps1 when deploying to Cloud Run.
# NEVER commit the filled-in .env.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
# Leave NODE_ENV unset (or "development") for local runs so .env is loaded.
# Cloud Run sets NODE_ENV=production itself; the OAuth redirect URL switches
# to https://fpows.redadair.com.au/auth/callback when production.
NODE_ENV=development
# Port the Express server listens on locally (defaults to 3000 if omitted).
PORT=3000
# LOCAL DEV ONLY: set to 1 to bypass Google login and preview the UI without
# OAuth credentials. Ignored when NODE_ENV=production. Leave unset/0 normally.
DEV_NO_AUTH=0

# --- simPRO API (REQUIRED — server refuses to start without these) ---------
# Base URL of your simPRO instance (no trailing slash).
SIMPRO_BASE_URL=https://redmen-uat.simprosuite.com
# simPRO API access token (Bearer token).
SIMPRO_ACCESS_TOKEN=your-simpro-access-token
# simPRO company ID (defaults to "1" if omitted).
SIMPRO_COMPANY_ID=1
# Safety: set to 1 to block ALL writes to simPRO (skips the asset-date sync).
# Strongly recommended when pointing at a PRODUCTION instance for testing.
SIMPRO_READ_ONLY=0

# --- Email / SMTP (Gmail, used for the daily manager report) ---------------
# Gmail address that sends the reports.
SMTP_USER=your-email@gmail.com
# Gmail APP PASSWORD (not your normal password — create one at
# https://myaccount.google.com/apppasswords with 2FA enabled).
SMTP_PASS=your-gmail-app-password
# Recipient of the automated daily report.
MANAGER_EMAIL=manager@redadair.com.au

# --- Internal API key (REQUIRED for deploy.ps1 / scheduler trigger) --------
# Protects admin endpoints such as /api/trigger-manager-report.
# Use a long random string.
ADMIN_API_KEY=your-long-random-admin-key

# --- Agent integration (optional) ------------------------------------------
# Shared secret that lets the standalone ADK agent (see /agent) call the FPOWS
# API server-to-server via the "x-agent-key" header (bypasses browser OAuth).
# Leave blank to disable programmatic access. Use a long random string.
AGENT_API_KEY=

# --- Google OAuth 2.0 (login is restricted to @redadair.com.au accounts) ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth client.
# Authorized redirect URIs must include:
#   http://localhost:3000/auth/callback           (local dev)
#   https://fpows.redadair.com.au/auth/callback    (production)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Secret used to sign Express sessions — use a long random string.
SESSION_SECRET=your-long-random-session-secret
