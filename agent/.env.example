# =============================================================================
# FPOWS ADK Agent — environment (copy to agent/.env and fill in)
# =============================================================================

# --- GCP / Vertex AI ---------------------------------------------------------
GOOGLE_CLOUD_PROJECT=fpows-500123
GOOGLE_CLOUD_LOCATION=us-central1
# Use Vertex AI (Gemini native) rather than an AI Studio API key.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GCS bucket used to stage the deployment package (must already exist).
STAGING_BUCKET=gs://your-staging-bucket

# --- Model -------------------------------------------------------------------
AGENT_MODEL=gemini-2.5-flash

# --- FPOWS integration -------------------------------------------------------
# Where the FPOWS API is reachable from the agent.
#   local:       http://localhost:3000
#   production:  https://fpows.redadair.com.au
FPOWS_API_BASE_URL=http://localhost:3000
# Must match AGENT_API_KEY in the FPOWS .env (server-to-server auth).
AGENT_API_KEY=match-the-one-in-fpows-env
FPOWS_TIMEOUT=20
